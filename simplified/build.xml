<?xml version="1.0" encoding="UTF-8"?>
<project name="simplified-starter" default="quick-deploy" basedir=".">
    <property name="src.dir" value="src/main/java"/>
    <property name="web.dir" value="src/main/webapp"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>

    <path id="classpath">
        <fileset dir="${env.CATALINA_HOME}/lib" erroronmissingdir="false">
            <include name="servlet-api.jar"/>
            <include name="jakarta.servlet-api-*.jar"/>
        </fileset>
    </path>

    <target name="clean">
        <delete dir="${classes.dir}"/>
    </target>

    <target name="init" depends="clean">
        <mkdir dir="${classes.dir}"/>
    </target>

    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${classes.dir}" includeantruntime="false">
            <classpath refid="classpath"/>
        </javac>
    </target>

    <target name="quick-deploy" depends="compile">
        <echo message="Deploying starter to ${env.CATALINA_HOME}/webapps/simplified"/>
        <delete dir="${env.CATALINA_HOME}/webapps/simplified" failonerror="false"/>
        <mkdir dir="${env.CATALINA_HOME}/webapps/simplified/WEB-INF/classes"/>
        <copy todir="${env.CATALINA_HOME}/webapps/simplified">
            <fileset dir="${web.dir}"/>
        </copy>
        <copy todir="${env.CATALINA_HOME}/webapps/simplified/WEB-INF/classes">
            <fileset dir="${classes.dir}"/>
        </copy>
        <echo message="Starter deployed to ${env.CATALINA_HOME}/webapps/simplified"/>
    </target>
</project>
